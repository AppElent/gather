# Generated by @appelent/dev env generate — do not edit by hand.
#
# Canonical source keys for gather.
# Infisical folders, in override order: /, /gather
# Routing source of truth: env.manifest.ts

# Clerk publishable key: pk_test_ locally and on web PR previews (Infisical dev and staging), pk_live_ for staging web, the installed preview app and production (Infisical prod). Published by design.
# Infisical: clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: local, preview, staging, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-build: local, staging, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-local: local)
#   published, required
clerk-publishable-key=

# Clerk JWT issuer domain, the Clerk↔Convex auth bridge. A Convex deployment without it refuses every authenticated call. Per-PR backends trust the development issuer.
# Infisical: clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: local, preview, production)
#   published, required
clerk-jwt-issuer-domain=

# Convex deployment URL the client connects to. Staging web and the mobile preview app read the production URL from Infisical prod (ADR-0039).
# Infisical: convex-url
#   VITE_CONVEX_URL (vite-build: local, preview, staging, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-build: local, staging, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-local: local)
#   published, required
convex-url=

# Which Convex deployment the local CLI talks to. Written by `convex dev`.
# Infisical: convex-deployment
#   CONVEX_DEPLOYMENT (local-tooling: local)
#   published, required
convex-deployment=

# Deploy key scoping every `convex` command in CI: preview kind in Infisical staging, prod: in prod. Absent from staging by design: a merge must not change the production backend (ADR-0039).
# Infisical: convex-deploy-key
#   CONVEX_DEPLOY_KEY (workflow: preview, production)
#   secret, required
convex-deploy-key=

# Whether the Sample household can be loaded. The Convex copy gates the mutation, the Vite copy shows the panel. Never staging or production, which share a deployment.
# Infisical: enable-sample-data
#   ENABLE_SAMPLE_DATA (convex-functions: local, preview)
#   VITE_ENABLE_SAMPLE_DATA (vite-build: local, preview)
#   published, required
enable-sample-data=

# Shared Clerk test-instance user for the sign-in page's one-click test login. Published: the build inlines it.
# Infisical: test-user-email
#   VITE_TEST_USER_EMAIL (vite-build: local)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-local: local)
#   published, optional
test-user-email=

# Password for that test user. Published for the same reason, so the account must never exist outside the Clerk test instance.
# Infisical: test-user-password
#   VITE_TEST_USER_PASSWORD (vite-build: local)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-local: local)
#   published, optional
test-user-password=

# Sentry DSN. Public by design: it only accepts events.
# Infisical: sentry-dsn
#   VITE_SENTRY_DSN (vite-build: local, preview, staging, production)
#   EXPO_PUBLIC_SENTRY_DSN (expo-build: staging, production)
#   published, optional
sentry-dsn=

# Sentry organisation slug, for source-map upload.
# Infisical: sentry-org
#   VITE_SENTRY_ORG (vite-build: local, preview, staging, production)
#   SENTRY_ORG (eas-tooling: staging, production)
#   published, optional
sentry-org=

# Sentry project slug, for source-map upload.
# Infisical: sentry-project
#   VITE_SENTRY_PROJECT (vite-build: local, preview, staging, production)
#   SENTRY_PROJECT (eas-tooling: staging, production)
#   published, optional
sentry-project=

# Uploads source maps and debug symbols: web builds in CI and `deploy:<environment>` (through env:exec), EAS native builds, and OTA publishes (`mobile:update:<channel>`). Never written to a local file.
# Infisical: sentry-auth-token
#   SENTRY_AUTH_TOKEN (workflow: preview, staging, production)
#   SENTRY_AUTH_TOKEN (eas-tooling: staging, production)
#   secret, optional
sentry-auth-token=

# The recipe URL-import action's AI fallback. Optional: JSON-LD imports work without it.
# Infisical: anthropic-api-key
#   ANTHROPIC_API_KEY (convex-functions: local, preview, production)
#   secret, optional
anthropic-api-key=

# Notion OAuth client ID. Public: it travels in the authorize URL.
# Infisical: notion-client-id
#   NOTION_CLIENT_ID (convex-functions: local, preview, production)
#   published, optional
notion-client-id=

# Notion OAuth client secret.
# Infisical: notion-client-secret
#   NOTION_CLIENT_SECRET (convex-functions: local, preview, production)
#   secret, optional
notion-client-secret=

# Todoist OAuth client ID. Public: it travels in the authorize URL.
# Infisical: todoist-client-id
#   TODOIST_CLIENT_ID (convex-functions: local, preview, production)
#   published, optional
todoist-client-id=

# Todoist OAuth client secret.
# Infisical: todoist-client-secret
#   TODOIST_CLIENT_SECRET (convex-functions: local, preview, production)
#   secret, optional
todoist-client-secret=

# Fine-grained token with Issues: read and write, for the in-app issue reporter.
# Infisical: github-issues-token
#   GITHUB_ISSUES_TOKEN (worker-runtime: local, preview, staging, production)
#   GITHUB_ISSUES_TOKEN (workflow: preview)
#   secret, optional
github-issues-token=

# Owner of the repo the issue reporter files into.
# Infisical: github-repo-owner
#   GITHUB_REPOSITORY_OWNER (worker-runtime: local, preview, staging, production)
#   published, optional
github-repo-owner=

# Name of the repo the issue reporter files into.
# Infisical: github-repo-name
#   GITHUB_REPOSITORY_NAME (worker-runtime: local, preview, staging, production)
#   GITHUB_REPOSITORY_NAME (workflow: preview)
#   published, optional
github-repo-name=

# Cloudflare API token used by wrangler to deploy and to set Worker secrets.
# Infisical: cloudflare-account-token
#   CLOUDFLARE_API_TOKEN (workflow: preview, staging, production)
#   secret, required
cloudflare-account-token=

# Cloudflare account for Worker deploys. An identifier, not a credential: workflows read it from vars.
# Infisical: cloudflare-account-id
#   CLOUDFLARE_ACCOUNT_ID (workflow: preview, staging, production)
#   published, required
cloudflare-account-id=
