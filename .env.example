# Generated by `pnpm run env:generate` — do not edit by hand.
#
# This lists every canonical Infisical key and where Gather reads it.
# Values live in the project selected by .infisical.json, under /
# and /gather. Run `pnpm run env:apply local` to generate local files.
#
# Routing source of truth: env.manifest.ts

# Clerk publishable key. Published by design; `pk_test_…` everywhere but production.
#   Infisical: clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: local, preview, stg, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-build: local, preview, stg, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-local: local)
#   published, required
clerk-publishable-key=

# Clerk JWT issuer domain, the Clerk↔Convex auth bridge. A Convex deployment without it refuses every authenticated call.
#   Infisical: clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: local, preview, stg, production)
#   published, required
clerk-jwt-issuer-domain=

# Convex deployment URL the client connects to.
#   Infisical: convex-url
#   VITE_CONVEX_URL (vite-build: local, preview, stg, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-build: local, preview, stg, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-local: local)
#   published, required
convex-url=

# Which Convex deployment the local CLI talks to. Written by `convex dev`; differs per developer.
#   Infisical: convex-deployment
#   CONVEX_DEPLOYMENT (local-tooling: local)
#   published, required
convex-deployment=

# Deploy key scoping every `convex` command in CI to one deployment. Its prefix (`preview:` / `prod:`) picks the target.
#   Infisical: convex-deploy-key
#   CONVEX_DEPLOY_KEY (workflow: preview, stg, production)
#   secret, required
convex-deploy-key=

# Whether the Sample household can be loaded. Two names, one decision: the Convex copy gates the mutation, the Vite copy shows the panel. Never production — its absence there is what keeps fake households out of real data.
#   Infisical: enable-sample-data
#   ENABLE_SAMPLE_DATA (convex-functions: local, preview, stg)
#   VITE_ENABLE_SAMPLE_DATA (vite-build: local, preview, stg)
#   published, required
enable-sample-data=

# Shared Clerk test-instance user for @appelent/auth's one-click login. Published, not secret: the build inlines it into a bundle served at a public URL.
#   Infisical: test-user-email
#   VITE_TEST_USER_EMAIL (vite-build: local, preview, stg)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-local: local)
#   published, optional
test-user-email=

# Password for that test user. Published for the same reason, which is why the account must never exist outside the Clerk test instance.
#   Infisical: test-user-password
#   VITE_TEST_USER_PASSWORD (vite-build: local, preview, stg)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-local: local)
#   published, optional
test-user-password=

# Sentry DSN. A DSN is public by design — it only accepts events.
#   Infisical: sentry-dsn
#   VITE_SENTRY_DSN (vite-build: local, preview, stg, production)
#   published, optional
sentry-dsn=

# Sentry organisation slug, for source-map upload.
#   Infisical: sentry-org
#   VITE_SENTRY_ORG (vite-build: local, preview, stg, production)
#   published, optional
sentry-org=

# Sentry project slug, for source-map upload.
#   Infisical: sentry-project
#   VITE_SENTRY_PROJECT (vite-build: local, preview, stg, production)
#   published, optional
sentry-project=

# Uploads source maps at build time. Build-time but never inlined — it has no VITE_ prefix, which is the whole reason `build-tooling` exists as a separate consumer.
#   Infisical: sentry-auth-token
#   SENTRY_AUTH_TOKEN (build-tooling: local, preview, stg, production)
#   secret, optional
sentry-auth-token=

# The recipe URL-import action's AI fallback. Optional: JSON-LD imports work without it, and a page with no matching JSON-LD simply fails to import.
#   Infisical: anthropic-api-key
#   ANTHROPIC_API_KEY (convex-functions: local, preview, stg, production)
#   secret, optional
anthropic-api-key=

# Notion OAuth client ID. Public — it travels in the authorize URL.
#   Infisical: notion-client-id
#   NOTION_CLIENT_ID (convex-functions: local, preview, stg, production)
#   published, optional
notion-client-id=

# Notion OAuth client secret.
#   Infisical: notion-client-secret
#   NOTION_CLIENT_SECRET (convex-functions: local, preview, stg, production)
#   secret, optional
notion-client-secret=

# Todoist OAuth client ID. Public — it travels in the authorize URL.
#   Infisical: todoist-client-id
#   TODOIST_CLIENT_ID (convex-functions: local, preview, stg, production)
#   published, optional
todoist-client-id=

# Todoist OAuth client secret.
#   Infisical: todoist-client-secret
#   TODOIST_CLIENT_SECRET (convex-functions: local, preview, stg, production)
#   secret, optional
todoist-client-secret=

# Fine-grained token with Issues: read and write, for the in-app issue reporter.
#   Infisical: github-issues-token
#   GITHUB_ISSUES_TOKEN (worker-runtime: local, preview, stg, production)
#   secret, optional
github-issues-token=

# Owner of the repo the issue reporter files into.
#   Infisical: github-repo-owner
#   GITHUB_REPOSITORY_OWNER (worker-runtime: local, preview, stg, production)
#   published, optional
github-repo-owner=

# Name of the repo the issue reporter files into.
#   Infisical: github-repo-name
#   GITHUB_REPOSITORY_NAME (worker-runtime: local, preview, stg, production)
#   published, optional
github-repo-name=

# Cloudflare API token used by wrangler to deploy and to set Worker secrets.
#   Infisical: cloudflare-api-token
#   CLOUDFLARE_API_TOKEN (workflow: preview, stg, production)
#   secret, required
cloudflare-api-token=

# Cloudflare account ID. An identifier rather than a credential, but kept secret so it stays out of the public workflow logs this repo produces.
#   Infisical: cloudflare-account-id
#   CLOUDFLARE_ACCOUNT_ID (workflow: preview, stg, production)
#   secret, required
cloudflare-account-id=

# read:packages token for the private @appelent/* GitHub Packages scope. Optional: the workflows fall back to GITHUB_TOKEN.
#   Infisical: node-auth-token
#   NODE_AUTH_TOKEN (workflow: preview, stg, production)
#   NODE_AUTH_TOKEN (eas-tooling: local, preview, stg, production)
#   secret, optional
node-auth-token=
