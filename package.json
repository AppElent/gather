{
  "name": "gather",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host",
    "dev:all": "pnpm exec convex dev --once && pnpm dev",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "generate-routes": "tsr generate",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "vite build && node scripts/generate-sw.mjs",
    "build:development": "vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "check": "biome check",
    "cf-typegen": "wrangler types",
    "seed": "pnpm exec convex run seed:seedCatalog && pnpm exec convex run seed:seedTastingCatalog",
    "seed:sample": "pnpm exec convex run seed:seedPreview",
    "deploy": "pnpm run deploy:prod",
    "deploy:dev": "pnpm exec convex dev --once && pnpm exec convex run seed:seedCatalog && pnpm exec convex run seed:seedTastingCatalog && pnpm run build:development && wrangler deploy --env dev",
    "deploy:prod": "pnpm exec convex deploy && pnpm exec convex run seed:seedCatalog --prod && pnpm exec convex run seed:seedTastingCatalog --prod && pnpm run build && wrangler deploy",
    "start": "node --import ./dist/server/instrument.server.mjs dist/server/index.mjs",
    "env:check": "node scripts/env.mjs check",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:plan": "node scripts/env.mjs plan"
  },
  "dependencies": {
    "@gather/core": "workspace:*",
    "@appelent/auth": "^0.1.0",
    "@appelent/i18n": "^0.1.0",
    "@clerk/clerk-react": "^5.61.3",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@convex-dev/react-query": "0.1.0",
    "@faker-js/faker": "^10.3.0",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-anthropic": "^0.19.3",
    "@tanstack/ai-client": "^0.36.0",
    "@tanstack/ai-gemini": "^0.34.1",
    "@tanstack/ai-ollama": "^0.11.11",
    "@tanstack/ai-openai": "^0.25.1",
    "@tanstack/ai-react": "^0.29.3",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/store": "^0.11.1",
    "convex": "^1.42.3",
    "dotenv-cli": "^11.0.0",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.3.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6",
    "zxing-wasm": "^3.1.1"
  },
  "devDependencies": {
    "@appelent/dev": "0.2.0",
    "@biomejs/biome": "2.4.5",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^28.1.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
