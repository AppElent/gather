{
  "name": "gather",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host",
    "dev:all": "pnpm exec convex dev --once && pnpm dev",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "generate-routes": "tsr generate",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "vite build && node scripts/generate-sw.mjs",
    "build:development": "vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "check": "biome check && node scripts/check-mobile-structure.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm --filter @gather/mobile typecheck && pnpm test",
    "cf-typegen": "wrangler types",
    "seed": "pnpm exec convex run seed:seedTastingCatalog",
    "seed:sample": "pnpm exec convex run seed:seedPreview",
    "deploy": "pnpm run deploy:production",
    "deploy:dev": "pnpm exec convex dev --once && pnpm exec convex run seed:seedTastingCatalog && CLOUDFLARE_ENV=dev pnpm run build:development && wrangler deploy",
    "deploy:staging": "node scripts/env.mjs exec staging --only github -- sh -c \"CLOUDFLARE_ENV=staging pnpm build && pnpm exec wrangler deploy\"",
    "deploy:production": "node scripts/env.mjs exec production --only github -- sh -c \"pnpm exec convex deploy --cmd-url-env-var-name CONVEX_URL --cmd 'VITE_CONVEX_URL=\\$CONVEX_URL pnpm build' && pnpm exec convex run seed:seedTastingCatalog && pnpm exec wrangler deploy\"",
    "env:check": "node scripts/env.mjs check",
    "env:plan": "node scripts/env.mjs plan",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:exec": "node scripts/env.mjs exec",
    "sentry:convex": "node scripts/convex-sentry.mjs",
    "mobile:update:preview": "node scripts/env.mjs exec staging --only eas -- node apps/mobile/scripts/publish-update.mjs preview",
    "mobile:update:production": "node scripts/env.mjs exec production --only eas -- node apps/mobile/scripts/publish-update.mjs production"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@gather/core": "workspace:*",
    "@sentry/cloudflare": "11.11.0",
    "@sentry/react": "11.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@edge-runtime/vm": "^5.0.0",
    "@sentry/node": "11.11.0",
    "@sentry/vite-plugin": "11.11.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "convex-test": "^0.0.67",
    "jsdom": "^28.1.0",
    "lefthook": "^2.2.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
