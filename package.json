{
  "name": "gather",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host",
    "dev:all": "pnpm exec convex dev --once && pnpm dev",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "generate-routes": "tsr generate",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "vite build && node scripts/generate-sw.mjs",
    "build:development": "vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "check": "biome check && node scripts/check-mobile-structure.mjs",
    "cf-typegen": "wrangler types",
    "seed": "pnpm exec convex run seed:seedCatalog && pnpm exec convex run seed:seedTastingCatalog",
    "seed:sample": "pnpm exec convex run seed:seedPreview",
    "deploy": "pnpm run deploy:prod",
    "deploy:dev": "pnpm exec convex dev --once && pnpm exec convex run seed:seedCatalog && pnpm exec convex run seed:seedTastingCatalog && CLOUDFLARE_ENV=dev pnpm run build:development && wrangler deploy",
    "deploy:prod": "pnpm exec convex deploy && pnpm exec convex run seed:seedCatalog --prod && pnpm exec convex run seed:seedTastingCatalog --prod && pnpm run build && wrangler deploy",
    "env:check": "node scripts/env.mjs check",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:plan": "node scripts/env.mjs plan"
  },
  "dependencies": {
    "@clerk/react": "^6.18.3",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@gather/core": "workspace:*",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/react": "11.10.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zxing-wasm": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@edge-runtime/vm": "^5.0.0",
    "@sentry/vite-plugin": "11.10.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^28.1.0",
    "lefthook": "^2.2.2",
    "sharp": "^0.35.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
