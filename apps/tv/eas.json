{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_TV": "1"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_TV": "1"
      }
    }
  }
}
