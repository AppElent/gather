# The names Metro reads. apps/mobile/.env.local is generated from Infisical by
# `pnpm env:apply local --only file` at the repository root (a new worktree's
# setup hook runs it); never edit it by hand, change env.manifest.ts instead.
#
# Every EXPO_PUBLIC_* value is embedded in the app bundle, so the optional test
# account must live on the Clerk test instance, never production.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: enables the one-tap test sign-in on test builds when both values
# are present.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=

EXPO_PUBLIC_CONVEX_URL=
# Optional debug flags, not in the manifest: set them in the shell for one run
# (`EXPO_PUBLIC_SENTRY_DEBUG=1 pnpm start`). Sentry is off in a development
# bundle; the DSN and this flag send from one, pointed at a throwaway listener
# (docs/runbooks/sentry.md). EXPO_PUBLIC_DEBUG_QUERIES=1 logs Convex
# subscriptions.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEBUG=
