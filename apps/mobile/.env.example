# Copy this file to .env.local before starting the Expo app.
#
# Use a Clerk development or test-instance key. Every EXPO_PUBLIC_* value is
# embedded in the app bundle, so the optional test account must never be a
# production account.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: enables the one-tap test sign-in on test builds when both values
# are present. Leave these unset for a normal local sign-in flow.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=
