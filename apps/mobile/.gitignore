# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# design-sync build output (regenerated by .ds-sync/build.mjs; the scripts and
# shims that produce it ARE tracked, the 1.3MB bundle it emits is not)
ds-bundle/
.ds-sync/sheet-*.html

app-example

# generated native folders
/ios
/android

# agent-device evidence: auto-named in the working directory by `record` and
# gesture capture. Keep a run's artifacts only by copying them somewhere named.
recording-*.gesture-telemetry.json
recording-*.mp4
# The same tool's scratch directory: build and Metro logs, screenshots taken
# while driving the app. Same rule — keep one by copying it somewhere named.
.agent-device/
