{
  "name": "@gather/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "devbuild:android": "expo run:android",
    "devbuild:android:clean": "expo prebuild --platform android --clean && expo run:android",
    "devbuild:android:eas": "eas build --platform android --profile development",
    "devbuild:ios:eas": "eas build --platform ios --profile development",
    "deploy:preview": "eas build --platform ios --profile preview --auto-submit",
    "deploy:prod": "eas build --platform ios --profile production",
    "build:preview:android": "eas build --platform android --profile preview-internal",
    "update:preview": "node scripts/publish-update.mjs preview",
    "update:prod": "node scripts/publish-update.mjs production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.4",
    "@expo/metro-runtime": "58.0.15",
    "@expo/ui": "^58.0.25",
    "@expo/vector-icons": "^15.0.3",
    "@gather/core": "workspace:*",
    "@sentry/react-native": "~8.31.0",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.134",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "^58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "9.0.0",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eas-cli": "16.32.0",
    "expo-device-hub": "^0.19.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "private": true
}
