{
  "name": "@gather/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "devbuild:android": "expo run:android",
    "devbuild:android:clean": "expo prebuild --platform android --clean && expo run:android",
    "devbuild:android:eas": "eas build --platform android --profile development",
    "devbuild:ios:eas": "eas build --platform ios --profile development",
    "deploy:preview": "eas build --platform ios --profile preview --auto-submit",
    "deploy:prod": "eas build --platform ios --profile production",
    "build:preview:android": "eas build --platform android --profile preview-internal",
    "update:preview": "eas update --channel preview --environment preview",
    "update:prod": "eas update --channel production --environment production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "echo \"//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}\" >> ~/.npmrc"
  },
  "dependencies": {
    "@clerk/expo": "^4.2.3",
    "@expo/metro-runtime": "57.0.16",
    "@expo/ui": "^57.0.19",
    "@expo/vector-icons": "^15.0.3",
    "@gather/core": "workspace:*",
    "convex": "^1.42.3",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-keep-awake": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "8.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "eas-cli": "^16.32.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
