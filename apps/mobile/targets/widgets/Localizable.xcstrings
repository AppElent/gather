{
  "sourceLanguage": "en",
  "strings": {
    "Open your card, or quickly add something": {
      "comment": "The control's description in the gallery: it opens the Loyalty card that was open, or else the quick-actions sheet (APP-443).",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open je pas, of snel iets toevoegen"
          }
        }
      }
    },
    "Quick actions": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle acties"
          }
        }
      },
      "comment": "The control's button and its name in the Action Button settings and the controls gallery. Same words as shell.homeScreenActions.quick in src/i18n/messages."
    },
    "Quick actions (%@)": {
      "comment": "The control's name on the preview and development builds; %@ is the variant, \"Preview\" or \"Dev\".",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle acties (%@)"
          }
        }
      }
    }
  },
  "version": "1.0"
}
