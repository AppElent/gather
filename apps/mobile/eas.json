{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "development",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
