{
  "expo": {
    "name": "Gather",
    "slug": "gather",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gather",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3d074dbc-2ee6-42bf-9383-55ef4085f5a7",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appelent.gather",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appelent.gather",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gather uses your photos so you can keep one with a memory in the baby log.",
          "cameraPermission": "Gather uses the camera so you can take a photo for a memory in the baby log."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f7",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#121413"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d074dbc-2ee6-42bf-9383-55ef4085f5a7"
      }
    },
    "owner": "appelent"
  }
}
