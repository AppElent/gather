# Public values for `production` — the `gather` Worker and the production Convex
# deployment, deployed by a workflow_dispatch from main (ADR 0013).
#
# Note what is *not* here, and cannot be: SAMPLE_DATA_ENABLED, TEST_USER_EMAIL
# and TEST_USER_PASSWORD are absent from production by declaration in
# env.manifest.ts, not by omission from this file. Adding them here would do
# nothing; the manifest never looks for them.

CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=

GITHUB_REPOSITORY_OWNER=AppElent
GITHUB_REPOSITORY_NAME=gather

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NOTION_CLIENT_ID=
TODOIST_CLIENT_ID=
