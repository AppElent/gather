# Public values for `stg` — the `gather-stg` Worker and the `staging` Convex
# deployment, deployed by a merge to main (ADR 0013).
#
# Staging inherits nothing: it is a prod-*type* Convex deployment, so the
# preview-type defaults do not reach it and everything here must be set
# explicitly. That is the hazard ADR 0013 names and this file answers.
#
# Blank entries below are genuinely not set yet. `pnpm run env:check stg` is the
# to-do list; fill these in and run `pnpm run env:apply stg`.

# A pk_test_… key: staging carries the sample household and the test-login
# button, so it must not point at the production Clerk instance.
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Safe here despite the standing "never on production" rule — that rule is about
# the deployment holding real households, not about the type label.
SAMPLE_DATA_ENABLED=true

GITHUB_REPOSITORY_OWNER=AppElent
GITHUB_REPOSITORY_NAME=gather

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NOTION_CLIENT_ID=
TODOIST_CLIENT_ID=
