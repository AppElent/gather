# Public values for `local`. Committed on purpose: none of these are
# confidential — the Clerk key is publishable by design, the Convex URL ships in
# every bundle, and two of the three were already in git via .cta.json.
#
# Secrets for this environment go in env/local.secret.env, which is ignored.
# Run `pnpm run env:apply local` to write .env.local from both.

CLERK_PUBLISHABLE_KEY=pk_test_Y2FsbS1jcmlja2V0LTgyLmNsZXJrLmFjY291bnRzLmRldiQ

# The Clerk instance's frontend API, which is what the publishable key encodes:
# base64-decoding the key above yields calm-cricket-82.clerk.accounts.dev.
CLERK_JWT_ISSUER_DOMAIN=https://calm-cricket-82.clerk.accounts.dev

# Every developer has their own Convex dev deployment. These two are written by
# `convex dev`; if yours differ, change them here rather than in .env.local.
CONVEX_DEPLOYMENT=basic-ibex-235
CONVEX_URL=https://basic-ibex-235.eu-west-1.convex.cloud

SAMPLE_DATA_ENABLED=true

GITHUB_REPOSITORY_OWNER=AppElent
GITHUB_REPOSITORY_NAME=gather

# Published, not secret: the build inlines these into the bundle, so the account
# must exist only on the Clerk test instance. Fill them in to get
# @appelent/auth's one-click dev login.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional. Leave blank to run without Sentry / AI recipe import / task providers.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NOTION_CLIENT_ID=
TODOIST_CLIENT_ID=
