# Public values for `preview` — the per-PR Convex backend and Worker.
#
# These land at GitHub *repo* scope, under the PREVIEW_ prefix, because
# preview.yml declares no `environment:`. See env.manifest.ts's REPO_SCOPE_PREFIX
# for why the prefix is a safety rule rather than a naming style.
#
# VITE_CONVEX_URL is deliberately absent: Convex mints a backend per PR and the
# workflow learns its URL from the deploy it just performed.

# Must be a pk_test_… key — the preview build publishes it, and the test-login
# button only appears for a test instance.
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=

SAMPLE_DATA_ENABLED=true

GITHUB_REPOSITORY_OWNER=AppElent
GITHUB_REPOSITORY_NAME=gather

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NOTION_CLIENT_ID=
TODOIST_CLIENT_ID=
