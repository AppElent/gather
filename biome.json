{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "apps/mobile/app/**/*",
      "convex/**/*",
      "scripts/**/*",
      "*.{ts,tsx,js,mjs,cjs}",
      "**/.vscode/**/*",
      "**/index.html",
      "**/vite.config.ts",
      "!**/.claude",
      "!convex/_generated",
      "!worker-configuration.d.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles.css",
      "!scripts/lib",
      "!scripts/baseline*.mjs",
      "!scripts/check-mobile-structure.mjs",
      "!scripts/check-project.mjs",
      "!scripts/env.mjs",
      "!scripts/sync-devtools.mjs",
      "!scripts/workspace.mjs",
      "!apps/mobile/ios",
      "!apps/mobile/android",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": false,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noAutofocus": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": { "skip": ["Notice"] }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.*", "src/lib/i18n/runtime/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noReactNativeRawText": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/**",
        "apps/mobile/app/**",
        "!apps/mobile/src/convex/api.ts"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/convex/_generated", "**/convex/_generated/**"],
                    "message": "Import api, Doc and Id from apps/mobile/src/convex/api (docs/standards/repo-layout.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/**",
        "apps/mobile/app/**",
        "!**/*.test.*",
        "!apps/mobile/src/convex/queries.ts",
        "!apps/mobile/src/auth/useViewer.ts",
        "!apps/mobile/src/convex/api.ts"
      ],
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/convex/_generated", "**/convex/_generated/**"],
                    "message": "Import api, Doc and Id from apps/mobile/src/convex/api (docs/standards/repo-layout.md)."
                  }
                ],
                "paths": {
                  "convex/react": {
                    "importNames": [
                      "useQuery",
                      "useQueries",
                      "usePaginatedQuery"
                    ],
                    "message": "Import query hooks from apps/mobile/src/convex/queries (docs/standards/convex-query-caching.md)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
