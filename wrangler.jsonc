{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gather",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // `stg` is what a merge to main deploys (see .github/workflows/deploy.yml).
  // `dev` is only ever reached by hand via `pnpm run deploy:dev` — dev proper is
  // local. Production is the top-level config, not an env block.
  "env": {
    "dev": { "name": "gather-dev", "workers_dev": true },
    "stg": { "name": "gather-stg", "workers_dev": true }
  }
}
