{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gather",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // `staging` is what a merge to main deploys (see .github/workflows/deploy.yml).
  // `dev` is only ever reached by hand via `pnpm run deploy:dev` — dev proper is
  // local. `pr` builds the per-PR preview Workers (preview.yml). Production is
  // the top-level config, not an env block.
  "env": {
    "dev": { "name": "gather-dev", "workers_dev": true },
    // Keeps the live Worker name `gather-stg` (env.manifest.ts
    // `worker.names.staging`). A custom domain, because the production Clerk
    // instance staging signs in through refuses origins outside appelent.nl
    // (ADR 0039).
    "staging": {
      "name": "gather-stg",
      "workers_dev": true,
      "routes": [{ "pattern": "gather-stg.appelent.nl", "custom_domain": true }]
    },
    // Route-free, so a preview deployed with `--name gather-pr-<N>` never
    // carries a custom domain.
    "pr": { "name": "gather-pr", "workers_dev": true, "routes": [] }
  }
}
